# FinFlow — PostgreSQL Environment Variables
# Скопируйте в .env.local и заполните значения

# PostgreSQL (Local)
DB_HOST=localhost
DB_PORT=USEYOURPORT
DB_NAME=USEYOURDBNAME
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# Для подключения как postgres (если нужно)
# DB_USER=postgres
# DB_PASSWORD=CHANGE_ME
